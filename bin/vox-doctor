#!/usr/bin/env python3
# Prints what vox still needs on this machine, one "name<TAB>why" line each; no output means ready.
# Run by the mod at session start; /vox setup (install.sh) fixes everything but the optional rows.
import filecmp
import json
import os
import shutil
import sys
from pathlib import Path

if sys.platform == "darwin":
    OS = "mac"
else:
    try:
        OS = "wsl" if "microsoft" in Path("/proc/version").read_text().lower() else "linux"
    except OSError:
        OS = "linux"
HERE = Path(__file__).resolve().parent.parent
C = Path.home() / ".claude"


def has(*names):
    return any(shutil.which(n) for n in names)


def is_executable(path):
    return os.access(path, os.X_OK) and Path(path).is_file()


def is_same(a, b):
    try:
        return filecmp.cmp(a, b, shallow=False)
    except OSError:
        return False


def has_vox_hooks():
    try:
        hooks = json.loads((C / "settings.json").read_text()).get("hooks", {})
        return any("hooks/vox " in h.get("command", "")
                   for groups in hooks.values() for g in groups for h in g.get("hooks", []))
    except (OSError, ValueError, AttributeError, TypeError):
        return False


def find_missing():
    if not has("python3"):
        yield "python3", "speech and sounds"
    if OS == "linux":
        if not has("piper", "espeak-ng", "spd-say"):
            yield "espeak-ng", "a voice"
        if not has("pw-play", "paplay", "aplay"):
            yield "player", "sounds (pulseaudio-utils)"
    elif OS == "wsl" and not has("powershell.exe"):
        yield "powershell.exe", "the Windows voice and player"
    installed = C / "hooks" / "vox"
    if not is_executable(installed):
        yield "scripts", "not installed"
    elif not is_same(HERE / "bin" / "vox", installed):
        yield "scripts", "older than the mod"
    if not (C / "hooks" / "vox.default.json").is_file():
        yield "settings", "no default settings"
    if not (C / "sounds" / "pack").is_dir():
        yield "sounds", "the sound pack is not made"
    if not has_vox_hooks():
        yield "hooks", "not in ~/.claude/settings.json"
    helper = C / "hooks" / "vox-helper"
    if OS == "mac":
        built = is_executable(helper / "vox-helper")
        if not built:
            yield "helper", "not built"
        elif not is_same(HERE / "helper/macos/Sources/vox-helper/main.swift", helper / "Sources/vox-helper/main.swift"):
            yield "helper", "older than the mod"
        if not built and not has("swift"):
            yield "swift", "Xcode command line tools, to build the helper"
    elif not (helper / "helper.py").is_file():
        yield "dictation (optional)", "/vox setup dictation"
    if not has("herdr"):
        yield "herdr (optional)", "live dictation and the stop key"


for name, why in find_missing():
    print(f"{name}\t{why}")
